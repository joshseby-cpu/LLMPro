# ─── macOS ───────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# ─── Xcode ───────────────────────────────────────────────────────────────
# project.yml is the source of truth; the .xcodeproj is generated by
# `xcodegen generate` (see INSTALL.md / docs/BUILDING.md). Don't commit it —
# it also tends to drag in per-user xcuserdata.
MLXStudio.xcodeproj/
*.xcworkspace/xcuserdata/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ─── Swift Package Manager ───────────────────────────────────────────────
.build/
.swiftpm/
Package.resolved

# ─── Python (helpers / tooling) ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ─── Claude Code (local, per-user) ───────────────────────────────────────
.claude/settings.local.json

# ─── App runtime data ────────────────────────────────────────────────────
# The app writes everything (Python venv, models, datasets, adapters, exports,
# SwiftData store) to ~/Library/Application Support/MLXStudio — never in-repo.
# These patterns are belt-and-suspenders in case anyone symlinks them here.
*.safetensors
*.gguf
*.log
